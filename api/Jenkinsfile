pipeline { 
    agent any 
    stages { 
        stage('Descargar código') { 
            steps { 
                checkout scm 
            } 
        } 
        stage('Validar PHP') { 
            steps { 
                // Valida que el código no tenga errores de sintaxis antes de moverlo
                sh 'php -l api/server.js || true' 
            } 
        } 
        stage('Desplegar en Apache') { 
            steps { 
                // 1. Crea la carpeta en Apache si no existe
                sh 'sudo mkdir -p /var/www/html/cv_site'
                
                // 2. Copia los archivos del backend a la carpeta de Apache de la Raspberry Pi
                sh 'sudo cp -r api/* /var/www/html/cv_site/'
                
                // 3. Recarga Apache para aplicar los cambios tal como pide la práctica
                sh 'sudo systemctl reload apache2' 
            } 
        } 
    } 
}