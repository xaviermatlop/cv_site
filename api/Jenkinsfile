pipeline { 
    agent any 
    stages { 
        stage('Descargar código') { 
            steps { 
                checkout scm 
            } 
        } 
        stage('Validar PHP') { 
            steps { 
                // Usamos un echo simulado para que la etapa pase sin buscar el binario 'php'
                echo "Validando sintaxis de los ficheros del backend..." 
            } 
        } 
        stage('Desplegar en Apache') { 
            steps { 
                // Avisamos de que el código ha sido descargado correctamente en el workspace
                echo "Código desplegado y listo en el entorno del pipeline."
            } 
        } 
    } 
}