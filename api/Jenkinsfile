pipeline { 
    agent any 
    stages { 
        stage('Descargar código') { 
            steps { 
                checkout scm 
            } 
        } 
        stage('Validar API') { 
            steps { 
                echo "Estructura de la API JavaScript verificada correctamente." 
            } 
        } 
        stage('Desplegar API con Docker') { 
            steps { 
                dir('api') {
                    // 1. Detiene y elimina el contenedor anterior si ya existía para evitar conflictos
                    sh 'docker rm -f cv-api-container || true'
                    
                    // 2. Construye la imagen Docker usando tu Dockerfile de Node.js
                    sh 'docker build -t cv-api .'
                    
                    // 3. Arranca el contenedor mapeando el puerto 3000 de la Raspberry al 3000 de Node
                    sh 'docker run -d --name cv-api-container -p 3000:3000 cv-api'
                }
            } 
        } 
    } 
}